<%# Ordered to match Projects::RecertificationsController, so the checklist
    rendered here is the one the gate will check when this form posts. %>
<% recert_review = project.ship_reviews.order(created_at: :desc, id: :desc).first %>
<% gated = recert_review&.returned? && recert_review.gates_resubmission? %>
<dialog id="recert-modal-<%= project.id %>"
        class="recert-modal"
        data-controller="modal"
        aria-labelledby="recert-modal-<%= project.id %>-title">
  <div class="recert-modal__panel">
    <button type="button"
            class="recert-modal__close"
            onclick="document.getElementById(<%= "recert-modal-#{project.id}".to_json %>).close()"
            aria-label="Close">
      &times;
    </button>

    <h3 id="recert-modal-<%= project.id %>-title" class="recert-modal__title">Changes requested</h3>
    <% if is_member %>
      <p class="recert-modal__subtitle">Your reviewer left feedback below. Address it and then request re-certification.</p>
    <% else %>
      <p class="recert-modal__subtitle">Reviewer feedback and walkthrough left for this project.</p>
    <% end %>

    <% verdict_video_src = certification_verdict_video_src(recert_review) %>
    <% if verdict_video_src %>
      <div class="recert-modal__video-wrap">
        <video class="recert-modal__video"
               controls
               preload="metadata"
               src="<%= verdict_video_src %>">
        </video>
      </div>
    <% end %>

    <%# When gated, the checklist renders the feedback itself - prose above, asks
        as boxes - so showing it here too would say everything twice. %>
    <% if recert_review&.feedback.present? && !gated %>
      <div class="recert-modal__feedback">
        <h4 class="recert-modal__feedback-label">Reviewer feedback</h4>
        <p class="recert-modal__feedback-body"><%= recert_review.feedback %></p>
      </div>
    <% end %>

    <%# The checkboxes are the "have you addressed the feedback?" question asked
        properly, so a gated form drops the confirm dialog that used to stand in
        for it. Someone acting on a builder's behalf still gets one. %>
    <% confirm_msg = if !is_member
         "This will request re-certification on behalf of the user. Continue?"
       elsif !gated
         "Have you addressed the feedback? This will re-enter the review queue."
       end %>
    <%= form_with url: project_recertification_path(project),
                  method: :post,
                  class: "recert-modal__form",
                  data: { turbo_confirm: confirm_msg,
                          controller: ("action-items" if gated),
                          action: ("submit->action-items#guard" if gated) }.compact do %>
      <% if gated %>
        <%= render "projects/action_items", review: recert_review %>
      <% end %>

      <div class="recert-modal__actions">
        <button type="button"
                class="recert-modal__btn recert-modal__btn--secondary"
                onclick="document.getElementById(<%= "recert-modal-#{project.id}".to_json %>).close()">
          Close
        </button>
        <%# No viewer check: show.html.erb only renders this modal for a member
            or a reviewer, so anyone reading it can act. %>
        <%= submit_tag "Request re-certification", class: "recert-modal__btn recert-modal__btn--primary",
              data: { action_items_target: ("submit" if gated) } %>
      </div>
    <% end %>
  </div>
</dialog>
