<%# Cockpit devlogs column — the project's real devlogs, newest first. Each card
    shows the log's date + hours logged, its body, any Lapse timelapses recorded
    during that log's window, and its image/video gallery. Soft-deleted devlogs
    are excluded (SoftDeletable default scope on @project.devlogs). Timelapse
    bucketing is a time-window heuristic (no per-devlog attribution upstream). %>
<% devlogs = @devlogs || @project&.devlogs&.to_a %>
<section class="hardware-cockpit__col hardware-cockpit__col--devlogs" aria-label="Devlogs"
         tabindex="0" data-cockpit-region="devlogs">
  <div class="hardware-cockpit__config-bar">
    <span class="hardware-cockpit__config-count"><%= pluralize(devlogs&.size || 0, "devlog") %></span>
    <div class="hardware-cockpit__sort" role="group" aria-label="Sort devlogs">
      <span class="hardware-cockpit__sort-label">Sort</span>
      <div class="hardware-cockpit__config-group">
        <button type="button" class="hardware-cockpit__config-btn is-active" aria-pressed="true"
                data-action="certification--hardware-cockpit#sortDevlogs" data-order="newest">Newest</button>
        <button type="button" class="hardware-cockpit__config-btn" aria-pressed="false"
                data-action="certification--hardware-cockpit#sortDevlogs" data-order="oldest">Oldest</button>
      </div>
    </div>
  </div>

  <div class="hardware-cockpit__devlogs" data-role="devlog-scroller">
    <% if devlogs.present? %>
      <% devlogs.each do |devlog| %>
        <% recordings = @devlog_timelapses&.dig(devlog.id) %>
        <article class="hardware-cockpit__devlog" data-time="<%= devlog.created_at.to_i %>">
          <header class="hardware-cockpit__devlog-head">
            <span class="hardware-cockpit__devlog-date">
              <time datetime="<%= devlog.created_at.iso8601 %>" title="<%= l(devlog.created_at, format: :long) %>">
                <%= time_ago_in_words(devlog.created_at) %> ago · <%= devlog.created_at.strftime("%Y/%m/%d %H:%M") %>
              </time>
            </span>
            <% if devlog.duration_seconds.to_i.positive? %>
              <span class="hardware-cockpit__devlog-hours"><%= format_seconds(devlog.duration_seconds) %> logged</span>
            <% end %>
          </header>

          <% if devlog.body.present? %>
            <div class="hardware-cockpit__devlog-body markdown-content">
              <%= md(devlog.body, allow_images: false) %>
            </div>
          <% end %>

          <%# Recordings (Lapse timelapses + Lookout sessions) recorded during this
              devlog's window, from @devlog_timelapses (normalized in the concern). %>
          <% if recordings.present? %>
            <div class="hardware-cockpit__timelapses">
              <span class="hardware-cockpit__timelapses-label"><%= pluralize(recordings.size, "recording") %></span>
              <ul class="hardware-cockpit__timelapse-strip">
                <% recordings.each do |rec| %>
                  <li>
                    <%# Click opens the in-app JKL player (openLapse preventDefaults);
                        the href stays so middle/ctrl-click still opens the raw video. %>
                    <a class="hardware-cockpit__timelapse" href="<%= rec[:playbackUrl] %>"
                       target="_blank" rel="noopener noreferrer" title="<%= rec[:name] %>"
                       data-action="certification--hardware-cockpit#openLapse">
                      <% if rec[:thumbnailUrl].present? %>
                        <img class="hardware-cockpit__timelapse-thumb" src="<%= rec[:thumbnailUrl] %>" alt="" loading="lazy">
                      <% else %>
                        <span class="hardware-cockpit__timelapse-thumb hardware-cockpit__timelapse-thumb--empty" aria-hidden="true">▶</span>
                      <% end %>
                      <span class="hardware-cockpit__timelapse-source"><%= rec[:source] %></span>
                      <span class="hardware-cockpit__timelapse-dur"><%= format_clock(rec[:duration]) %></span>
                    </a>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%# Only render the media gallery when the devlog actually has media —
              an empty gallery left a big blank box in the card. %>
          <% if devlog.attachments.attached? %>
            <%= render "shared/post_media", attachments: devlog.attachments, variant: :large, lazy: true %>
          <% end %>
        </article>
      <% end %>
    <% else %>
      <p class="hardware-cockpit__devlogs-empty">No devlogs yet.</p>
    <% end %>
  </div>
</section>
