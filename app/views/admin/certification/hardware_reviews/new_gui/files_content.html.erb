<%# Cockpit file-browser payload: a collapsible file-tree rail beside a preview
    pane. Clicking a file asks the file_preview endpoint for it and
    hardware-file-browser swaps it into the preview body (which defaults to the
    rendered README); the pop-out button blows the current preview up into a
    large modal. Reads @file_tree / @readme_html / @readme_error (set by #files).
    @file_tree is nil on a fetch failure, [] for an empty repo, or an array of
    { path:, size: }. %>
<nav class="hardware-cockpit__files-rail" aria-label="Repository files">
  <% if @file_tree.nil? %>
    <p class="hardware-cockpit__files-note">Couldn't load the file list.</p>
  <% elsif @file_tree.empty? %>
    <p class="hardware-cockpit__files-note">No files in this repository.</p>
  <% else %>
    <div class="hardware-cockpit__files-railhead">
      <span class="hardware-cockpit__files-count"><%= pluralize(@file_tree.size, "file") %></span>
      <button type="button" class="hardware-cockpit__files-readme"
              data-action="certification--hardware-file-browser#showReadme">README</button>
    </div>
    <%= render "admin/certification/hardware_reviews/new_gui/file_tree",
          nodes: RepoFileTree.build(@file_tree) %>
  <% end %>
</nav>

<div class="hardware-cockpit__preview">
  <div class="hardware-cockpit__preview-bar">
    <button type="button" class="hardware-cockpit__preview-popout"
            data-action="certification--hardware-file-browser#popOut" title="Open in a large modal">⤢ Pop out</button>
  </div>
  <div class="hardware-cockpit__preview-body">
    <% if @readme_html.present? %>
      <div class="markdown-content"><%= @readme_html.html_safe %></div>
    <% elsif @readme_error.present? %>
      <p class="hardware-cockpit__files-note"><%= @readme_error %></p>
    <% else %>
      <p class="hardware-cockpit__files-note">No README to show — pick a file to preview it.</p>
    <% end %>
  </div>
</div>
