if approved
  header ":tada: Your build was approved!"

  section "*<#{project_url}|#{project_title}>* passed review. Your stardust payout is on its way.", markdown: true

  section "*Feedback:* #{feedback}", markdown: true if feedback.present?
elsif rejected
  header ":no_entry: Your build was rejected"

  section "*<#{project_url}|#{project_title}>* can't be certified, and it can't be resubmitted for review.", markdown: true

  section "*Feedback:* #{feedback}", markdown: true if feedback.present?
else
  header ":pencil: Your build needs changes"

  section "*<#{project_url}|#{project_title}>* isn't approved yet. Address the feedback below and ship again.", markdown: true

  section "*Feedback:* #{feedback}", markdown: true if feedback.present?
end

actions [
  button("View project", "view_project", url: project_url)
]
